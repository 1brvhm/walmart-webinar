# REQUIRED. Zapier catch hook that receives webinar registrations.
# Treat this URL as a secret: anyone who has it can post data into your Zap.
# Never commit the real value — set it here locally and in your host's
# environment settings (Vercel: Project Settings > Environment Variables).
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/
